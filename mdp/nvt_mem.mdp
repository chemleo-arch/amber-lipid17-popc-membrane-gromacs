; ===== 膜 NVT (100 ps, 脂质重原子位置约束) =====
integrator               = md
dt                       = 0.002
nsteps                   = 50000
define                   = -DPOSRES
nstxout                  = 5000
nstvout                  = 5000
nstenergy                = 5000
nstlog                   = 5000
cutoff-scheme            = Verlet
ns_type                  = grid
nstlist                  = 20
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
constraints              = h-bonds
constraint_algorithm     = LINCS
continuation             = no
comm-mode                = none
tcoupl                   = V-rescale
tc-grps                  = System
tau_t                    = 0.1
ref_t                    = 300
pbc                      = xyz
gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = 42
