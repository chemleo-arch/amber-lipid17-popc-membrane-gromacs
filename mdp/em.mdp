; ===== 能量最小化 em.mdp (GAFF2/AMBER 适用) =====
integrator               = steep
nsteps                   = 50000
emtol                    = 1000.0
emstep                   = 0.01
cutoff-scheme            = Verlet
ns_type                  = grid
nstlist                  = 10
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = No
pbc                      = xyz
